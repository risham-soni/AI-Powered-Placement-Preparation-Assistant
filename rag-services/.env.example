# ==========================================
# RAG Microservice Environment Configuration
# ==========================================

# Port the FastAPI service runs on (default: 8000)
PORT=8000

# Google Gemini API Key for LLM answer generation
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Secret matching backend JWT_SECRET for token verification
JWT_SECRET=placement_assistant_super_secret_change_this_later

# Qdrant Vector Database
# Option 1: Local embedded disk storage (No Docker needed!)
# QDRANT_PATH=./qdrant_data

# Option 2: Cloud or Local Docker URL
# Cloud example: https://[CLUSTER_ID].aws.cloud.qdrant.io
# Local Docker example: http://localhost:6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key_here_if_using_cloud

# Optional: HuggingFace Token to avoid rate limits when downloading all-MiniLM-L6-v2
# HF_TOKEN=hf_...

