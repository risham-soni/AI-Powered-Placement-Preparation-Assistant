# ==========================================
# Express Backend Environment Configuration
# ==========================================

# Port the backend runs on (default: 5000)
PORT=5000

# Secret key used for signing JWT tokens
JWT_SECRET=placement_assistant_super_secret_change_this_later

# PostgreSQL Connection String (Cloud Supabase / Neon or Local PostgreSQL)
# Local example: postgresql://postgres:postgres@localhost:5432/placement_db
# Cloud example: postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/placement_db

# Set to "false" if using local PostgreSQL without SSL
# DB_SSL=false

# URL of the Python FastAPI RAG microservice
# Local default: http://127.0.0.1:8000
# Production Render example: https://ai-powered-placement-rag.onrender.com
RAG_SERVICE_URL=http://127.0.0.1:8000
